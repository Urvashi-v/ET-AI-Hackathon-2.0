# =============================================================================
# Unified Asset & Operations Brain -- environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Values left blank are genuinely optional; the system fails loudly and
# truthfully at the feature boundary rather than substituting fake data.
# =============================================================================

# --- Core service identity ------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL (relational store, chunk store, BM25 index, pgvector) ------
# REQUIRED. docker-compose provides these defaults for local development.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=industrial_brain
POSTGRES_USER=brain
POSTGRES_PASSWORD=change_me_locally
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# --- Neo4j (knowledge graph) ----------------------------------------------
# REQUIRED. NEO4J_AUTH in docker-compose must match NEO4J_USERNAME/PASSWORD.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_locally
NEO4J_DATABASE=neo4j

# --- Redis (ingestion queue, event bus, cache) ----------------------------
# REQUIRED.
REDIS_URL=redis://redis:6379/0

# --- Object/blob storage ---------------------------------------------------
# Local filesystem path inside the containers where uploaded originals live.
BLOB_ROOT=/app/data/blobs

# =============================================================================
# EXTERNAL AI PROVIDERS
# -----------------------------------------------------------------------------
# The system NEVER substitutes a fake provider. If a provider is not
# configured, the affected stage reports status "provider_not_configured" and
# the pipeline degrades truthfully rather than inventing anything: with no LLM
# the extractive composer still answers from verbatim spans of cited passages,
# and with no evidence at all the answer is an abstention that names a referral.
# =============================================================================

# --- Embedding provider (dense retrieval) ---------------------------------
# EMBEDDING_PROVIDER: none | openai | local
#   none    -> dense retrieval disabled, reported as unavailable (default)
#   openai  -> requires OPENAI_API_KEY
#   local   -> real ONNX models via fastembed. No credential, no torch, and no
#              network call after the first model download. This is the default.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-en-v1.5

# --- Generation provider (grounded answer synthesis, extraction, RCA) -----
# LLM_PROVIDER: none | openai | anthropic
#   none      -> no prose is *synthesised*, but answers are still produced: the
#                extractive composer assembles them from verbatim spans of the
#                cited passages, so /api/v1/query returns a real cited answer.
#                What a provider adds is synthesis, and it is what makes answer
#                correctness measurable against a judge.
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1500

# >>> CREDENTIALS YOU MUST SUPPLY (leave blank if the provider is unused) <<<
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Reranker (cross-encoder) ---------------------------------------------
# RERANKER_PROVIDER: none | local
RERANKER_PROVIDER=local
RERANKER_LOCAL_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Intra-op threads for the local ONNX models (embedding + reranker). ONNX Runtime
# otherwise opens one thread per visible CPU, which oversubscribes a container
# that does not own those cores and makes inference latency swing several-fold.
# Raise it on a dedicated inference host.
ONNX_THREADS=4

# --- OCR (scanned documents / P&ID raster text) ---------------------------
# OCR_PROVIDER: none | paddle | tesseract
OCR_PROVIDER=tesseract        # tesseract is installed in the image; no credentials needed

# =============================================================================
# EXTERNAL SYSTEM CONNECTORS
# Interfaces exist; none are connected. Configure to enable. An unconfigured
# connector reports status "not_configured" -- it never emits synthetic records.
# =============================================================================
CMMS_CONNECTOR=none              # none | sap_pm | maximo | csv_export
CMMS_BASE_URL=
CMMS_API_KEY=

S3_CONNECTOR_ENABLED=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SHAREPOINT_CONNECTOR_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# --- Ingestion tuning ------------------------------------------------------
INGEST_MAX_FILE_MB=100
INGEST_ALLOWED_EXTENSIONS=.pdf,.txt,.md,.csv,.json,.docx,.png,.jpg,.jpeg,.tif,.tiff
INGEST_QUEUE_NAME=queue:ingest
INGEST_WORKER_CONCURRENCY=1
INGEST_VISIBILITY_TIMEOUT_S=900

# --- Retrieval tuning ------------------------------------------------------
RETRIEVAL_TOP_K_LEXICAL=50
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_GRAPH=50
RETRIEVAL_RRF_K=60
RETRIEVAL_FINAL_K=8
CONFIDENCE_ANSWER_THRESHOLD=0.75
CONFIDENCE_CAVEAT_THRESHOLD=0.50

# --- Entity resolution thresholds (see services/common/tags.py) -----------
ER_AUTO_MERGE_THRESHOLD=0.90
ER_REVIEW_THRESHOLD=0.60
